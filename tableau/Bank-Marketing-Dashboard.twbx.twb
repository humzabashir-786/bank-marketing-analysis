      <column caption='Total Subscribed' datatype='integer' name='[Calculation_3066772492439552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [subscribed] = &quot;Yes&quot; THEN&#10;1&#10;ELSE&#10;0&#10;END' />
