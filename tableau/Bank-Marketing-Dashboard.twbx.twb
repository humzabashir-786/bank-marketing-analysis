      <column caption='Subscription Rate' datatype='real' default-format='p0.0%' name='[Calculation_3066772497956866]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;IF [subscribed] = &quot;Yes&quot; THEN 1&#10;ELSE 0&#10;END&#10;)&#10;/COUNT([subscribed])' />
